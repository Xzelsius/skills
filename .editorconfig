# Schema: http://EditorConfig.org

root = true

[*]
charset = utf-8
end_of_line = lf
indent_style = space
insert_final_newline = true
trim_trailing_whitespace = true

# JSON files
[*.{json,json5}]
indent_size = 2

# YAML files
[*.{yml,yaml}]
indent_size = 2

# JavaScript files
[*.{js,mjs,cjs}]
indent_size = 2

# Markdown files
[*.md]
max_line_length = 150

# Bash files
[*.sh]
indent_size = 2
binary_next_line = true
switch_case_indent = true

{
  "config": {
    "default": true,

    // Line length: 150, as in .editorconfig. Tables and code blocks are exempt.
    "MD013": {
      "line_length": 150,
      "tables": false,
      "code_blocks": false
    },

    // Headings may repeat under different parents, e.g. an "Install" section per host.
    "MD024": {
      "siblings_only": true
    }
  },
  "globs": ["**/*.md"],
  "ignores": ["node_modules/**"]
}
